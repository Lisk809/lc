# 开发环境：直接调用线上 API（CORS 已开放 *；本地后端 8787 未启动时仍可联调）
# 本地后端联调时改回 http://localhost:8787（或留空走 vite 代理）
VITE_API_BASE=https://lc.lisks.icu
# 本地 Mock 管理员：true 时 fetchMe 后强制 is_admin = true
VITE_ADMIN_OVERRIDE=true
# 可选：仅将指定用户 ID 模拟为管理员（不设置则对所有用户生效）
# VITE_ADMIN_USER_ID=your-user-uuid
# Cloudflare Turnstile 站点密钥（创建后填入；本地开发需在控制台把 localhost 加入域名白名单）
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAEQkjTNUvjvcdZyN
